---
// Reading progress for long-form stories, in three parts:
//   1. A thin bar at the top of the viewport that fills as the reader moves
//      through the article body (throttled scroll listener, one update per frame).
//   2. A countdown pill: "Chapter 3 of 8 · 4 min left", estimated at 230 wpm.
//   3. A chapter rail in the left margin (xl screens and up) that highlights the
//      current chapter (IntersectionObserver) and jumps to any chapter.
// Smooth scrolling and transitions are turned off under prefers-reduced-motion.
//
// Expects the article body to be marked [data-story-body] and each chapter to be
// a <section data-chapter id="..."> inside it. Sections also marked
// data-chapter-meta (a colophon, say) are tracked but not numbered or counted.

interface Props {
	chapters: { id: string; title: string; meta?: boolean }[];
}

const { chapters } = Astro.props;
// Number only the narrative chapters.
let n = 0;
const numbered = chapters.map((c) => ({ ...c, num: c.meta ? undefined : ++n }));
---

<div
	class="pointer-events-none fixed inset-x-0 top-0 z-50 h-0.5 bg-transparent"
	aria-hidden="true"
>
	<div
		class="h-full origin-left scale-x-0 bg-zinc-200 will-change-transform"
		data-progress-bar
	>
	</div>
</div>

<nav
	aria-label="Chapters"
	class="story-rail fixed top-32 z-30 hidden opacity-0 transition-opacity duration-300 motion-reduce:transition-none xl:block"
	data-rail
>
	<p class="mb-4 text-xs font-medium uppercase tracking-[0.2em] text-zinc-500">Chapters</p>
	<ol class="space-y-0.5 border-l border-zinc-800 text-sm">
		{numbered.map(({ id, title, num }) => (
			<li>
				<a
					href={`#${id}`}
					data-rail-link={id}
					class="-ml-px flex gap-2.5 border-l-2 border-transparent py-1.5 pl-3 leading-snug text-zinc-500 transition-colors hover:text-zinc-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-400 motion-reduce:transition-none aria-[current=true]:border-zinc-200 aria-[current=true]:text-zinc-50"
				>
					<span class="w-4 shrink-0 tabular-nums text-zinc-600">{num}</span>
					<span>{title}</span>
				</a>
			</li>
		))}
	</ol>
</nav>

<div
	class="pointer-events-none fixed inset-x-0 bottom-[max(1rem,env(safe-area-inset-bottom))] z-30 flex justify-center px-4 md:justify-end md:px-6"
	aria-hidden="true"
>
	<p
		class="translate-y-2 rounded-full border border-zinc-800 bg-zinc-950/90 px-4 py-2 text-xs font-medium tabular-nums text-zinc-300 opacity-0 shadow-lg shadow-black/40 backdrop-blur-md transition duration-300 motion-reduce:transition-none"
		data-pill
	>
		<span data-pill-chapter></span>
		<span class="text-zinc-600"> · </span>
		<span data-pill-time></span>
	</p>
</div>

<style is:global>
	/* Rail sits to the left of the wide images (column half-width 24rem + 4rem
	   wide overhang + 1.5rem gap), anchored by its right edge. */
	.story-rail {
		right: calc(50% + 29.5rem);
		width: min(13rem, calc(50% - 30.5rem));
	}
	.story-rail[data-visible] {
		opacity: 1;
	}
	.story-rail:not([data-visible]) {
		pointer-events: none;
	}
	[data-pill][data-visible] {
		opacity: 1;
		transform: none;
	}
</style>

<script>
	const WPM = 230;

	const body = document.querySelector<HTMLElement>('[data-story-body]');
	const bar = document.querySelector<HTMLElement>('[data-progress-bar]');
	const rail = document.querySelector<HTMLElement>('[data-rail]');
	const pill = document.querySelector<HTMLElement>('[data-pill]');
	const pillChapter = document.querySelector<HTMLElement>('[data-pill-chapter]');
	const pillTime = document.querySelector<HTMLElement>('[data-pill-time]');
	const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-story-body] section[data-chapter]'));
	const railLinks = new Map(
		Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-rail-link]')).map((a) => [a.dataset.railLink, a]),
	);

	if (body && bar && pill && pillChapter && pillTime && sections.length) {
		const narrative = sections.filter((s) => !s.hasAttribute('data-chapter-meta'));
		const total = narrative.length;
		let current = 0;
		let overBleed = false;

		// Word count per text block, with each block's position on the page.
		// Positions are re-measured on resize and whenever the body changes size.
		type Block = { top: number; words: number };
		let blocks: Block[] = [];
		const blockEls = Array.from(body.querySelectorAll<HTMLElement>('h2, h3, p, li, blockquote'));
		const wordCounts = blockEls.map((el) => (el.textContent ?? '').trim().split(/\s+/).filter(Boolean).length);
		let bodyTop = 0;
		let bodyHeight = 1;

		function measure() {
			const y = window.scrollY;
			const rect = body!.getBoundingClientRect();
			bodyTop = rect.top + y;
			bodyHeight = rect.height;
			blocks = blockEls.map((el, i) => ({ top: el.getBoundingClientRect().top + y, words: wordCounts[i] }));
			document.documentElement.style.setProperty(
				'--sbw',
				`${window.innerWidth - document.documentElement.clientWidth}px`,
			);
		}

		function update() {
			const y = window.scrollY;
			const vh = window.innerHeight;
			const progress = Math.min(1, Math.max(0, (y + vh - bodyTop) / bodyHeight));
			// Progress counts from the moment the body enters the viewport until its end reaches the bottom.
			const started = y + vh * 0.6 > bodyTop;
			bar!.style.transform = `scaleX(${started ? progress : 0})`;

			// Words not yet read: every block that starts below the reading line (40% down the screen).
			const line = y + vh * 0.4;
			let remaining = 0;
			for (const b of blocks) if (b.top > line) remaining += b.words;
			const minutes = Math.ceil(remaining / WPM);

			const section = sections[current];
			pillChapter!.textContent = section.hasAttribute('data-chapter-meta')
				? (section.querySelector('h2')?.textContent ?? '').trim()
				: `Chapter ${narrative.indexOf(section) + 1} of ${total}`;
			pillTime!.textContent = minutes <= 0 ? 'Done' : minutes === 1 ? 'Under 1 min left' : `${minutes} min left`;
			const showPill = started && progress < 1;
			pill!.toggleAttribute('data-visible', showPill);
			rail?.toggleAttribute('data-visible', started && progress < 1 && !overBleed);
		}

		let ticking = false;
		function onScroll() {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(() => {
				ticking = false;
				update();
			});
		}

		function setCurrent(index: number) {
			current = index;
			const id = sections[index].id;
			for (const [key, link] of railLinks) {
				if (key === id) link.setAttribute('aria-current', 'true');
				else link.removeAttribute('aria-current');
			}
			update();
		}

		// A chapter is current while it crosses a thin band 40% down the viewport.
		const chapterObserver = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) setCurrent(sections.indexOf(entry.target as HTMLElement));
				}
			},
			{ rootMargin: '-40% 0px -59% 0px' },
		);
		sections.forEach((s) => chapterObserver.observe(s));

		// Hide the rail while a full-bleed photo passes behind it.
		const visibleBleeds = new Set<Element>();
		const bleedObserver = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) visibleBleeds.add(entry.target);
					else visibleBleeds.delete(entry.target);
				}
				overBleed = visibleBleeds.size > 0;
				update();
			},
			{ rootMargin: '-96px 0px -30% 0px' },
		);
		body.querySelectorAll('.story-bleed').forEach((el) => bleedObserver.observe(el));

		measure();
		setCurrent(0);
		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', () => {
			measure();
			onScroll();
		});
		new ResizeObserver(() => {
			measure();
			onScroll();
		}).observe(body);
	}
</script>
