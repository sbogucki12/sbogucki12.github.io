---
// A single native <dialog> shared by every StoryFigure on the page.
// showModal() gives us focus containment, Escape to close, an inert page
// behind it, and focus returning to the trigger on close.
---

<dialog
	id="story-lightbox"
	aria-label="Photo viewer"
	class="m-auto max-h-none max-w-none bg-transparent p-0 backdrop:bg-zinc-950/90 backdrop:backdrop-blur-sm"
>
	<div class="flex h-dvh w-screen items-center justify-center p-4 sm:p-8" data-lightbox-backdrop>
		<img
			alt=""
			class="max-h-full max-w-full rounded-lg object-contain shadow-2xl"
			data-lightbox-img
			decoding="async"
		/>
	</div>
	<button
		type="button"
		class="fixed right-4 top-4 inline-flex items-center gap-2 rounded-full border border-zinc-700 bg-zinc-900/90 px-4 py-2 text-sm font-medium text-zinc-100 transition-colors hover:bg-zinc-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-300 motion-reduce:transition-none"
		data-lightbox-close
	>
		<svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="size-4">
			<path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
		</svg>
		Close
	</button>
</dialog>

<script>
	const dialog = document.getElementById('story-lightbox') as HTMLDialogElement | null;
	const img = dialog?.querySelector<HTMLImageElement>('[data-lightbox-img]');

	if (dialog && img && typeof dialog.showModal === 'function') {
		document.addEventListener('click', (event) => {
			const trigger = (event.target as Element).closest<HTMLElement>('[data-lightbox-src]');
			if (!trigger) return;
			img.src = trigger.dataset.lightboxSrc ?? '';
			img.alt = trigger.dataset.lightboxAlt ?? '';
			dialog.showModal();
			document.documentElement.style.overflow = 'hidden';
		});

		dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());

		// Clicking anywhere outside the photo closes the viewer.
		dialog.addEventListener('click', (event) => {
			if (event.target !== img) dialog.close();
		});

		dialog.addEventListener('close', () => {
			document.documentElement.style.overflow = '';
			img.removeAttribute('src');
		});
	}
</script>
